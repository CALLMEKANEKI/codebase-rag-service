LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Comma-separated model IDs in fallback priority order.
# For free-tier testing, use openrouter/free or explicit IDs ending in :free.
# Paid model IDs are also supported and may incur charges.
OPENROUTER_MODELS=openrouter/free
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Codebase RAG Service

# Optional Gemini provider (set LLM_PROVIDER=gemini to use it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

RAG_API_KEY=
QDRANT_PATH=storage/qdrant
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto
EMBEDDING_CACHE_PATH=storage/embedding_cache.sqlite
INDEX_STORAGE_PATH=storage/indexes
INDEX_REGISTRY_PATH=storage/index_registry.sqlite
LLM_TIMEOUT_MS=60000
